# PostgreSQL Database Configuration for AWS
# Copy this file to .env and update with your actual AWS RDS/EC2 PostgreSQL credentials

# Database Host (your AWS EC2 instance public IP or RDS endpoint)
DB_HOST=your-aws-instance-ip-or-rds-endpoint.amazonaws.com

# Database Port (default PostgreSQL port)
DB_PORT=5432

# Database Name
DB_NAME=caffein

# Database User
DB_USER=postgres

# Database Password
DB_PASSWORD=your-secure-password-here

# Flask Configuration
FLASK_ENV=development
